PORT=3000

# Optional security: set to validate the Webflow webhook signature
# WEBFLOW_WEBHOOK_SECRET=replace-with-shared-secret

# ClickShip API configuration
CLICKSHIP_BASE_URL=https://api.clickship.io
CLICKSHIP_API_KEY=replace-with-clickship-api-key
CLICKSHIP_SETTLEMENT_PATH=/v1/settlements/orders

# Keep these lower than your serverless max duration to avoid 504 timeouts
# CLICKSHIP_TIMEOUT_MS=7000
# WEBHOOK_PROCESSING_TIMEOUT_MS=8000
